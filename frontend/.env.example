# URL do backend, lida pelo Vite em BUILD TIME.
#
# Netlify (producao):  https://SEU-PROJETO.vercel.app
# Dev local:           deixe VAZIO e use o proxy do vite.config.ts
#
# Em MODO HOST este valor e ignorado de proposito: o backend do host injeta
# window.__GUITARSLASH_HOST__ no index.html e o frontend passa a usar a
# propria origem. Assim o mesmo frontend/dist serve o Netlify e a LAN.
VITE_API_URL=

# Servidor de partidas do multiplayer ONLINE (WebSocket).
#
# Aceita https:// e converte para wss:// sozinho.
# Vazio = multiplayer online desligado; o botao fica desabilitado no menu.
# NAO aponte para a Vercel: Serverless Function nao mantem WebSocket aberto.
#
# Em MODO HOST este valor e ignorado: a LAN usa a propria origem e funciona
# offline. Lida em BUILD TIME, entao mudar exige novo deploy.
VITE_WS_URL=
