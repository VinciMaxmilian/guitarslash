# ---------------------------------------------------------------- BACKEND
# Pasta da biblioteca de musicas (somente em dev / modo host).
# Em producao na Vercel esta pasta NAO existe: o filesystem e efemero.
GUITARSLASH_SONGS_DIR=./songs

# Origens autorizadas, separadas por virgula. Em producao: o dominio do Netlify.
#
# Vale para o CORS da API E para o WebSocket do multiplayer. No WebSocket ela
# importa mais: WS nao passa por CORS, entao o navegador nao protege nada e a
# checagem de origem e feita pelo servidor com esta lista.
GUITARSLASH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# local  -> le songs/ do disco (dev e modo host)
# remote -> le de object storage/CDN (producao; ver backend/app/storage/remote.py)
GUITARSLASH_STORAGE=local

# Base publica dos assets quando GUITARSLASH_STORAGE=remote
GUITARSLASH_ASSETS_BASE_URL=

# Base publica do bucket `community` do Supabase Storage.
#
# Necessaria para TOCAR musica da comunidade: o backend busca o notes.mid daqui
# e faz o parse (o parser e o mesmo da biblioteca local, de proposito - dois
# parsers divergiriam e dessincronizariam a partida).
#
# Sem esta variavel, /api/community/* responde 503 dizendo o que falta.
# Formato: https://SEU-PROJETO.supabase.co/storage/v1/object/public/community
GUITARSLASH_COMMUNITY_BASE_URL=

# Diretorio de cache do indice da biblioteca.
# Vazio = usa o diretorio temporario do sistema (obrigatorio na Vercel).
GUITARSLASH_CACHE_DIR=

# ---------------------------------------------------------------- FRONTEND
# O frontend le a propria copia em frontend/.env (ver frontend/.env.example).
# Em dev deixe VAZIO: o proxy do vite.config.ts encaminha /api e /ws para o
# backend local. Em modo host o valor e ignorado de proposito.
