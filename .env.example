# ---------------------------------------------------------------- BACKEND
# Pasta da biblioteca de musicas (somente em dev / modo host).
# Em producao na Vercel esta pasta NAO existe: o filesystem e efemero.
GUITARSLASH_SONGS_DIR=./songs

# Origens autorizadas no CORS, separadas por virgula.
# Em producao: o dominio do Netlify.
GUITARSLASH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# local  -> le songs/ do disco (dev e modo host)
# remote -> le de object storage/CDN (producao; ver backend/app/storage/remote.py)
GUITARSLASH_STORAGE=local

# Base publica dos assets quando GUITARSLASH_STORAGE=remote
GUITARSLASH_ASSETS_BASE_URL=

# Diretorio de cache do indice da biblioteca.
# Vazio = usa o diretorio temporario do sistema (obrigatorio na Vercel).
GUITARSLASH_CACHE_DIR=

# ---------------------------------------------------------------- FRONTEND
# Consumido pelo Vite em build time (frontend/.env).
# Vazio = usa a origem atual, que e o comportamento do modo host.
VITE_API_URL=http://localhost:8000
